rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    function validItem() {
      return request.resource.data.keys().hasOnly([
        'type', 'title', 'title_ne', 'summary', 'body', 'url',
        'fileType', 'published', 'date'
      ])
      && request.resource.data.type in ['update', 'highlight', 'article', 'news', 'opportunity', 'video', 'resource']
      && request.resource.data.title is string
      && request.resource.data.title.size() > 0
      && request.resource.data.title.size() <= 200
      && request.resource.data.title_ne is string
      && request.resource.data.title_ne.size() <= 200
      && request.resource.data.summary is string
      && request.resource.data.summary.size() <= 500
      && request.resource.data.body is string
      && request.resource.data.body.size() <= 20000
      && request.resource.data.url is string
      && request.resource.data.url.size() <= 500
      && request.resource.data.fileType is string
      && request.resource.data.fileType.size() <= 8
      && request.resource.data.published is bool
      && request.resource.data.date is string
      && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    match /items/{itemId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create, update: if isAdmin() && validItem();
      allow delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if settingId == 'socialLinks'
                  && resource.data.links is list
                  && resource.data.links.size() <= 50;
      allow create, update: if isAdmin()
                           && settingId == 'socialLinks'
                           && request.resource.data.keys().hasOnly(['links'])
                           && request.resource.data.links is list
                           && request.resource.data.links.size() <= 50;
      allow delete: if false;
    }

    match /submissions/{submissionId} {
      allow create: if request.resource.data.keys().hasOnly([
                         'type', 'title', 'body', 'name', 'email', 'link',
                         'date', 'createdAt'
                       ])
                    && request.resource.data.type in ['article', 'news']
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() <= 200
                    && request.resource.data.body is string
                    && request.resource.data.body.size() > 0
                    && request.resource.data.body.size() <= 20000
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 100
                    && request.resource.data.email is string
                    && request.resource.data.email.size() <= 120
                    && request.resource.data.link is string
                    && request.resource.data.link.size() <= 500
                    && request.resource.data.date is string
                    && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      allow read, update, delete: if isAdmin();
    }
  }
}
